# Public web configuration
VITE_API_URL=http://localhost:4000

# API and browser origin
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://studyroom:studyroom@localhost:5432/studyroom
# Optional separate direct/session-pooler URL for migrations on Supabase.
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# LiveKit Cloud wss://... or local ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional participant reminder email delivery (server-only).
# Gmail: use smtp.gmail.com with port 465 + secure true, or port 587 + secure false.
# Render free web services block both Gmail SMTP ports; use a paid instance.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional one-time bootstrap input. Locally, pass these only to the bootstrap
# command. On Render free tier, temporary values trigger bootstrap during startup;
# remove them after confirming the administrator can log in.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Reverse proxies only: comma-separated trusted hop count/IPs as supported by Express.
TRUST_PROXY=false

